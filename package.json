{
  "name": "paritydiff",
  "version": "0.0.0",
  "private": true,
  "description": "Self-Maintaining API Platform - monorepo root",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "pnpm --filter @paritydiff/db run migrate",
    "migrate:down": "pnpm --filter @paritydiff/db run migrate:down",
    "seed": "tsx scripts/seed-dev.ts",
    "env:init": "node scripts/gen-local-env.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-istanbul": "2.1.9",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "fast-check": "^4.9.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.0",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
